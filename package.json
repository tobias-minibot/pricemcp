{
  "name": "pricemcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Trusted, normalized, freshness-aware price data for AI",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/server.ts",
    "collect": "tsx src/cli.ts collect",
    "collect:brightdata": "tsx src/cli.ts collect:brightdata",
    "snapshot:vercel": "tsx scripts/build-vercel-snapshot.ts",
    "seed": "tsx src/cli.ts seed",
    "demo:seed": "PRICEMCP_DB=./data/pricemcp-demo.db tsx src/seed-demo.ts",
    "demo:start": "PRICEMCP_DB=./data/pricemcp-demo.db tsx src/seed-demo.ts && PRICEMCP_DB=./data/pricemcp-demo.db PRICEMCP_DATASET=pricemcp-demo-v1 PRICEMCP_SCHEDULER=false PORT=3200 tsx src/server.ts",
    "mcp": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/mcp-stdio.ts",
    "verify:duffel": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/verify-duffel.ts",
    "audit:workflows": "tsx src/workflow-audit.ts",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:submission": "npm run verify:live && node scripts/verify-submission.mjs",
    "trueforge": "npx @truefoundry/trueforge@0.1.4",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "cheerio": "^1.1.2",
    "croner": "^9.1.0",
    "fastify": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
