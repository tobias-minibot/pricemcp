PORT=3199
HOST=127.0.0.1
PRICEMCP_DB=./data/pricemcp.db
PRICEMCP_SCHEDULER=true
PRICEMCP_COLLECT_ON_START=false
# Optional defense-in-depth bearer authentication. Tailscale Serve already
# provides the staging network boundary; do not commit a real token here.
PRICEMCP_API_TOKEN=
# Prefer Best Buy's maintained official API when a key is supplied.
BESTBUY_API_KEY=
# Optional legitimate flight source. Test mode uses Amadeus's limited test
# dataset and is always labeled synthetic; set AMADEUS_ENV=production only with
# production credentials and authorization.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test
# Duffel sandbox tokens begin with duffel_test_. Production tokens are rejected
# unless DUFFEL_ENV=production is set explicitly.
DUFFEL_ACCESS_TOKEN=
DUFFEL_ENV=test
# Public search protection. Provider cache/budgets are per warm process; use a
# shared store before relying on them as a distributed production quota.
PRICEMCP_PUBLIC_SEARCH_RATE_LIMIT_PER_MINUTE=30
PRICEMCP_FLIGHT_CACHE_TTL_SECONDS=60
PRICEMCP_FLIGHT_MAX_CONCURRENT_SEARCHES=4
PRICEMCP_FLIGHT_PROVIDER_CALLS_PER_HOUR=120
PRICEMCP_ALERT_WEBHOOK_URL=
