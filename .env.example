PORT=3199
HOST=127.0.0.1
PRICEMCP_DB=./data/pricemcp.db
PRICEMCP_SCHEDULER=true
PRICEMCP_COLLECT_ON_START=false
# Optional defense-in-depth bearer authentication. Tailscale Serve already
# provides the staging network boundary; do not commit a real token here.
PRICEMCP_API_TOKEN=
# Prefer Best Buy's maintained official API when a key is supplied.
BESTBUY_API_KEY=
# Optional legitimate flight source. Test mode uses Amadeus's limited test
# dataset and is always labeled synthetic; set AMADEUS_ENV=production only with
# production credentials and authorization.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test
PRICEMCP_ALERT_WEBHOOK_URL=
